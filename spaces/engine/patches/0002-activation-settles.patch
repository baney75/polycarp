+/// BaneySpaces addition (engine/patches/0002-activation-settles.patch). A flat two seconds cost every first look at
+/// every app, for a tree that a native app has complete at once. Only a web engine builds its tree after being asked, so
+/// this watches the windows' trees: a native tree that holds still is done, a web area with content must hold still for
+/// longer, and a window with next to nothing in it, or an empty web area, gets the old two seconds as its cap.
+fn settle(application: &crate::tree::AXElement, cap: Duration, deadline: Deadline) {
+    const POLL: Duration = Duration::from_millis(30);
+    if cap.is_zero() {
+        return;
+    }
+    let start = std::time::Instant::now();
+    let mut last = None;
+    let mut still_since = start;
+    loop {
+        let shape = sample_tree(application, deadline);
+        let now = std::time::Instant::now();
+        if last != Some(shape.elements) {
+            last = Some(shape.elements);
+            still_since = now;
+        }
+        let still = now.duration_since(still_since);
+        let settled = settled_after(shape).is_some_and(|quiet| still >= quiet);
+        if settled || now.duration_since(start) >= cap {
+            return;
+        }
+        std::thread::sleep(POLL);
+    }
+}
+
+/// How long this tree must hold still, or None while it can't be finished.
+fn settled_after(shape: TreeShape) -> Option<Duration> {
+    if shape.unknown || shape.empty_web_area || shape.elements < MIN_ELEMENTS {
+        None
+    } else if shape.web_area {
+        Some(QUIET_WEB)
+    } else {
+        Some(QUIET_NATIVE)
+    }
+}
+
+const QUIET_NATIVE: Duration = Duration::from_millis(100);
+const QUIET_WEB: Duration = Duration::from_millis(300);
+const MIN_ELEMENTS: usize = 5;
+const MAX_SAMPLED_ELEMENTS: usize = 300;
+
+#[derive(Clone, Copy, Default)]
+struct TreeShape {
+    elements: usize,
+    web_area: bool,
+    empty_web_area: bool,
+    /// The walk stopped short or a read failed, so it can't vouch for the tree holding still.
+    unknown: bool,
+}
+
+/// A bounded walk of the app's windows. Anything it can't read counts as not being there, so it waits longer, never less.
+fn sample_tree(application: &crate::tree::AXElement, deadline: Deadline) -> TreeShape {
+    let mut shape = TreeShape { unknown: true, ..TreeShape::default() };
+    let Ok(limit) = instant(deadline) else {
+        return shape;
+    };
+    let Ok(mut queue) = crate::tree::surface_read::elements(application, "AXWindows", limit) else {
+        return shape;
+    };
+    while let Some(element) = queue.pop() {
+        shape.elements += 1;
+        if shape.elements >= MAX_SAMPLED_ELEMENTS {
+            return shape;
+        }
+        let Ok(limit) = instant(deadline) else {
+            return shape;
+        };
+        let Ok(children) = crate::tree::surface_read::elements(&element, "AXChildren", limit) else {
+            return shape;
+        };
+        if crate::tree::surface_read::string(&element, "AXRole", limit).ok().flatten().as_deref() == Some("AXWebArea") {
+            shape.web_area = true;
+            shape.empty_web_area |= children.is_empty();
+        }
+        queue.extend(children);
+    }
+    shape.unknown = false;
+    shape
+}
