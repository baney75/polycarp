+
+#[test]
+fn pasteboard_items_are_known_by_action_and_by_title_without_one() {
+    assert!(is_pasteboard_item(Some("copy:"), None));
+    assert!(is_pasteboard_item(Some("pasteAndMatchStyle:"), Some("Einsetzen und Stil anpassen")));
+    assert!(!is_pasteboard_item(Some("syncMode:"), Some("Copy")), "an app's own item titled Copy");
+    assert!(is_pasteboard_item(None, Some("Paste")));
+    assert!(is_pasteboard_item(Some(" "), Some("copy")));
+    assert!(is_pasteboard_item(Some("menu.edit.copy"), Some("Copy")), "an app's own identifier on a real Copy item");
+    assert!(!is_pasteboard_item(Some("menu.edit.copy"), Some("Kopieren")));
+    assert!(!is_pasteboard_item(None, Some("Kopieren")), "a title without an identifier is English only");
+    assert!(!is_pasteboard_item(None, None));
+}
