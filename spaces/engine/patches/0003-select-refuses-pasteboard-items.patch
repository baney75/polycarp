+/// BaneySpaces addition (engine/patches/0003-select-refuses-pasteboard-items.patch). The general pasteboard is the
+/// user's: a cut, copy or paste item is refused once its menu is open and the item is found, before it is pressed. A
+/// closed popup's items are not in any snapshot, so only this read sees them. By the AppKit action the item is wired
+/// to (its AX identifier, in any language), and by English title for an item with no identifier shaped like an action:
+/// an app may set its own (`menu.edit.copy`) on a real Copy item.
+const PASTEBOARD_ACTIONS: [&str; 6] = [
+    "cut:",
+    "copy:",
+    "paste:",
+    "pasteasplaintext:",
+    "pasteandmatchstyle:",
+    "pasteasrichtext:",
+];
+const PASTEBOARD_TITLES: [&str; 5] = [
+    "cut",
+    "copy",
+    "paste",
+    "paste and match style",
+    "paste as plain text",
+];
+
+fn action(identifier: Option<&str>) -> Option<&str> {
+    identifier.map(str::trim).filter(|id| id.ends_with(':'))
+}
+
+fn is_pasteboard_item(identifier: Option<&str>, title: Option<&str>) -> bool {
+    match action(identifier) {
+        Some(id) => PASTEBOARD_ACTIONS.contains(&id.to_ascii_lowercase().as_str()),
+        None => title.is_some_and(|t| PASTEBOARD_TITLES.contains(&t.trim().to_lowercase().as_str())),
+    }
+}
+
+fn refuse_pasteboard_item(candidate: &AXElement, deadline: Deadline) -> Result<(), AdapterError> {
+    let instant = crate::tree::locator_deadline::from_operation(deadline)?;
+    let identifier = crate::tree::surface_read::string(candidate, "AXIdentifier", instant)?;
+    let title = match action(identifier.as_deref()) {
+        Some(_) => None,
+        None => crate::tree::surface_read::string(candidate, "AXTitle", instant)?,
+    };
+    if !is_pasteboard_item(identifier.as_deref(), title.as_deref()) {
+        return Ok(());
+    }
+    Err(AdapterError::new(
+        ErrorCode::PolicyDenied,
+        "Select refused a cut, copy or paste menu item",
+    )
+    .with_details(serde_json::json!({
+        "kind": "pasteboard_item",
+        "identifier": identifier.unwrap_or_default(),
+        "title": title.unwrap_or_default(),
+    })))
+}
