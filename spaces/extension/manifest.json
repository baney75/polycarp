{
  "manifest_version": 3,
  "name": "Polycarp",
  "short_name": "Polycarp",
  "version": "2.0.0",
  "description": "Readable text on any page, a Reader for pages, PDFs and ebooks, read-aloud, calmer feeds, a linked library, and Polycarp's new tab.",
  "minimum_chrome_version": "120",
  "key": "",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Polycarp",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "options_ui": {
    "page": "src/pages/settings.html",
    "open_in_tab": true
  },
  "chrome_url_overrides": {
    "newtab": "newtab/newtab.html"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "contextMenus",
    "activeTab",
    "scripting",
    "alarms",
    "nativeMessaging"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/shared/core.js",
        "src/shared/bionic.js",
        "src/shared/filters.js",
        "src/content/sites.js",
        "src/content/filters.js",
        "src/content/finder.js",
        "src/content/content.js"
      ],
      "css": [
        "src/content/content.css"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_origin_as_fallback": true
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "src/shared/core.js",
        "src/shared/edits.js",
        "src/shared/edits-store.js",
        "src/content/edits.js",
        "src/content/edits-notice.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "fonts/*.woff2",
        "src/shared/theme.css"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "commands": {
    "toggle-page": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      },
      "description": "Turn Polycarp on or off for this site"
    },
    "open-reader": {
      "suggested_key": {
        "default": "Alt+Shift+R"
      },
      "description": "Open this page or PDF in the Polycarp Reader"
    },
    "toggle-ruler": {
      "suggested_key": {
        "default": "Alt+Shift+F"
      },
      "description": "Show or hide the focus ruler"
    },
    "open-finder": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Search this page (and a video's transcript or the posts you've seen)"
    },
    "edit-page": {
      "description": "Edit this page: hide, reword, restyle, move or add a note"
    }
  },
  "omnibox": {
    "keyword": "pc"
  }
}
