# What the Mac app is called, in one place. Sourced by bundle.sh, package.sh, install-app.sh and
# release.sh; install.sh and uninstall.sh run alone (curl | bash) and carry copies that
# InstallScriptTests keeps equal to this file. Swift reads the same names from Product.swift,
# which ProductNameTests keeps equal too. The Swift modules keep the name BaneySpaces.
PRODUCT_NAME=Polycarp
BUNDLE_ID=com.baney.polycarp
EXECUTABLE=Polycarp
# The bundled command, and the older names that still run it (agents and hooks call them).
CLI_NAME=polycarp-spaces
CLI_ALIASES="baneyspaces ghostdeck"
SUPPORT_FOLDER=Polycarp
# The app this one replaces; only migration and the old-app notice use these.
LEGACY_NAME=BaneySpaces
LEGACY_BUNDLE_ID=com.baney.baneyspaces
LEGACY_SUPPORT_FOLDER=BaneySpaces
# Silas, the dictation app whose voice is now inside Polycarp. install-app.sh quits it, installs, then moves it to the
# Trash. Its data folder stays.
SILAS_NAME=Silas
SILAS_BUNDLE_ID=com.baney.silas
