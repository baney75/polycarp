{
 "about": "Page edits: what Edits.swift and the extension's src/shared/edits.js both take and both refuse. Each refused case names the field the refusal must point at; an accepted case with sites says what they become.",
 "rules": {"about": "What any code that applies an edit must keep to, whatever a selector matches. text, attr, insert and move leave an element in never or in editors, or inside one, or any other a person types in (isContentEditable), as it is. move also leaves one that is or holds an element in editors or carry, so no field or button lands in another form, and one that is or holds a video, audio, canvas, shadow root or custom element; it shows a copy without the page's ids, scripts or handlers and hides the page's own, which stays where it is. text with no find leaves an element that holds one of those, a video, audio or canvas: it swaps the words, never what else is there.",
  "never": ["base", "embed", "iframe", "input", "link", "meta", "noscript", "object", "option", "script", "select", "source", "style", "template", "textarea", "track"], "editors": ["[contenteditable]:not([contenteditable=false])", "[role=textbox]"], "carry": ["button", "embed", "iframe", "input", "object", "select", "textarea"]},
 "accept": [
  {"case": "hide", "edit": {"id": "a", "sites": ["example.com"], "changes": [{"do": "hide", "at": "#ads, .promo"}]}},
  {"case": "style", "edit": {"id": "a", "sites": ["example.com"], "changes": [{"do": "style", "at": "article", "style": {"font-size": "18px", "max-width": "calc(100% - 2rem)", "--gap": "4px"}}]}},
  {"case": "text", "edit": {"id": "a", "sites": ["example.com"], "changes": [{"do": "text", "at": "h1", "text": "Home", "find": "Welcome"}]}},
  {"case": "text to nothing", "edit": {"id": "a", "sites": ["example.com"], "changes": [{"do": "text", "at": "h1", "text": ""}]}},
  {"case": "attr", "edit": {"id": "a", "sites": ["example.com"], "changes": [{"do": "attr", "at": "img.map", "name": "alt", "value": "A map"}]}},
  {"case": "attr taken away", "edit": {"id": "a", "sites": ["example.com"], "changes": [{"do": "attr", "at": "img", "name": "title", "value": null}]}},
  {"case": "move", "edit": {"id": "a", "sites": ["example.com"], "changes": [{"do": "move", "at": "#nav", "to": "main", "where": "first"}]}},
  {"case": "insert", "edit": {"id": "a", "sites": ["example.com"], "changes": [{"do": "insert", "at": "main", "where": "first", "blocks": [{"kind": "heading", "text": "Today"}, {"kind": "text", "text": "Read this first"}, {"kind": "list", "items": ["One", "Two"]}, {"kind": "link", "text": "More", "url": "https://example.org/a?b=c#d"}]}]}},
  {"case": "css", "edit": {"id": "a", "sites": ["example.com"], "css": "/* wide */ @media (width < 600px) { main { width: 100% } }"}},
  {"case": "paths and name", "edit": {"id": "a", "sites": ["example.com"], "name": "Calm", "paths": ["/home", "/watch/*"], "css": "a{color:red}"}},
  {"case": "pseudo-classes, and colons in a string", "edit": {"id": "a", "sites": ["example.com"], "changes": [{"do": "hide", "at": "a:first-child:hover, [title='a::before']"}]}},
  {"case": "a function as a variable's fallback", "edit": {"id": "a", "sites": ["example.com"], "changes": [{"do": "style", "at": "a", "style": {"width": "var(--w,calc(100% - 2rem))"}}], "css": "a{color:var(--a,var(--b,rgb(0,0,0)))}"}},
  {"case": "two dashes that call nothing", "edit": {"id": "a", "sites": ["example.com"], "css": ".btn--big:not(.x){width:calc(var(--w) * 2);--y:calc(1px)}"}},
  {"case": "off", "edit": {"id": "a", "sites": ["example.com"], "enabled": false, "css": "a{color:red}"}},
  {"case": "site as a link", "edit": {"id": "a", "sites": ["https://www.Example.com/path"], "css": "a{color:red}"}},
  {"case": "vendor and custom properties", "edit": {"id": "a", "sites": ["example.com"], "changes": [{"do": "style", "at": "a", "style": {"-webkit-line-clamp": "2", "--Gap_x": "4px", "scroll-behavior": "smooth"}}]}},
  {"case": "css that only scrolls smoothly", "edit": {"id": "a", "sites": ["example.com"], "css": "html{scroll-behavior:smooth} .card--big:hover::before{content:\"@home\"} /* me@example.com */"}},
  {"case": "a list that says a thing twice", "edit": {"id": "a", "sites": ["example.com"], "changes": [{"do": "insert", "at": "p", "where": "after", "blocks": [{"kind": "list", "items": ["Eggs", "Eggs"]}]}]}},
  {"case": "localhost", "edit": {"id": "a", "sites": ["localhost:3000"], "css": "a{}"}},
  {"case": "a www host stays one", "sites": ["www.gov.uk"], "edit": {"id": "a", "sites": ["www.gov.uk"], "css": "a{}"}},
  {"case": "hide what only hide and style may name", "edit": {"id": "a", "sites": ["example.com"], "changes": [{"do": "hide", "at": "div > iframe.ad"}]}},
  {"case": "text in a class named like a tag", "edit": {"id": "a", "sites": ["example.com"], "changes": [{"do": "text", "at": "style-guide .style, #textarea", "text": "x"}]}},
  {"case": "a custom element named like a tag", "edit": {"id": "a", "sites": ["example.com"], "changes": [{"do": "text", "at": "main > style-guide, select-menu.x", "text": "x"}]}},
  {"case": "sites as hosts", "sites": ["x.com", "sub.example.com"], "edit": {"id": "a", "sites": ["https://X.com:443/home", "x.com", " Sub.Example.com "], "css": "a{filter:blur(2px)}"}},
  {"case": "data in a word, not a fetch", "edit": {"id": "a", "sites": ["example.com"], "css": ".curl-up{color:red}"}}
 ],
