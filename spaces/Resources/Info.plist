<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleExecutable</key><string>Polycarp</string>
  <key>CFBundleIdentifier</key><string>com.baney.polycarp</string>
  <key>CFBundleName</key><string>Polycarp</string>
  <key>CFBundleDisplayName</key><string>Polycarp</string>
  <key>CFBundleIconFile</key><string>Polycarp</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleShortVersionString</key><string>@VERSION@</string>
  <key>CFBundleVersion</key><string>@BUILD_NUMBER@</string>
  <key>PolycarpVersion</key><string>@FULL_VERSION@</string>
  <key>PolycarpChannel</key><string>@CHANNEL@</string>
  <key>PolycarpCommit</key><string>@COMMIT@</string>
  <key>PolycarpCommitDate</key><string>@COMMIT_DATE@</string>
  <key>PolycarpCommitDirty</key><string>@DIRTY@</string>
  <key>LSMinimumSystemVersion</key><string>13.0</string>
  <key>LSUIElement</key><true/>
  <key>NSAppleEventsUsageDescription</key><string>Polycarp reads the tabs and splits of your terminals and browser to list them in the launcher, brings forward the one you pick, and types into a terminal only when you or an agent asks it to.</string>
  <key>LSApplicationCategoryType</key><string>public.app-category.productivity</string>
  <key>NSHighResolutionCapable</key><true/>
  <key>NSHumanReadableCopyright</key><string>© 2026 Donovan Baney (@baney75). MIT License.</string>
  <key>CFBundleURLTypes</key>
  <array><dict>
    <key>CFBundleURLName</key><string>com.baney.polycarp</string>
    <key>CFBundleURLSchemes</key><array><string>polycarp</string><string>baneyspaces</string></array>
  </dict></array>
  <!-- The player (spec/player.md): Polycarp is an Alternate handler only, so it shows up in Open With and never takes a default from the app you chose. -->
  <key>CFBundleDocumentTypes</key>
  <array>
    <dict>
      <key>CFBundleTypeName</key><string>Audio</string>
      <key>CFBundleTypeRole</key><string>Viewer</string>
      <key>LSHandlerRank</key><string>Alternate</string>
      <key>LSItemContentTypes</key>
      <array>
        <string>public.mp3</string>
        <string>com.apple.m4a-audio</string>
        <string>org.xiph.flac</string>
        <string>com.microsoft.waveform-audio</string>
        <string>public.aac-audio</string>
      </array>
    </dict>
    <dict>
      <key>CFBundleTypeName</key><string>Video</string>
      <key>CFBundleTypeRole</key><string>Viewer</string>
      <key>LSHandlerRank</key><string>Alternate</string>
      <key>LSItemContentTypes</key>
      <array>
        <string>public.mpeg-4</string>
        <string>com.apple.quicktime-movie</string>
        <string>com.apple.m4v-video</string>
        <string>org.matroska.mkv</string>
      </array>
    </dict>
    <dict>
      <key>CFBundleTypeName</key><string>Photo</string>
      <key>CFBundleTypeRole</key><string>Viewer</string>
      <key>LSHandlerRank</key><string>Alternate</string>
      <key>LSItemContentTypes</key>
      <array>
        <string>public.jpeg</string>
        <string>public.png</string>
        <string>public.heic</string>
        <string>public.heif</string>
        <string>com.compuserve.gif</string>
        <string>org.webmproject.webp</string>
        <string>public.camera-raw-image</string>
      </array>
    </dict>
  </array>
  <!-- Matroska has no system declaration on every macOS; imported, so an app that exports it wins. -->
  <key>UTImportedTypeDeclarations</key>
  <array>
    <dict>
      <key>UTTypeIdentifier</key><string>org.matroska.mkv</string>
      <key>UTTypeDescription</key><string>Matroska video</string>
      <key>UTTypeConformsTo</key><array><string>public.movie</string></array>
      <key>UTTypeTagSpecification</key>
      <dict>
        <key>public.filename-extension</key><array><string>mkv</string></array>
        <key>public.mime-type</key><array><string>video/x-matroska</string></array>
      </dict>
    </dict>
  </array>
</dict>
</plist>
